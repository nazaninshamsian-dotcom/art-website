# Postgres connection (Vercel Postgres, Neon, or Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Stripe — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From the Stripe CLI or your webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."

# Vercel Blob — created automatically when you add Blob storage in your Vercel project
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Password you'll use to log into /admin
ADMIN_PASSWORD="choose-a-strong-password"

# Your deployed site URL (used as a fallback for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
